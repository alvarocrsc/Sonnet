<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/import_files_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/ic_back_dark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/import_title"
            app:layout_constraintBottom_toBottomOf="@id/username_subtitle"/>

        <!-- Import Files Title -->
        <TextView
            android:id="@+id/import_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="35dp"
            android:fontFamily="@font/geist_black"
            android:text="Import Files"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:letterSpacing="-0.016"
            android:lineSpacingMultiplier="0.5"
            app:layout_constraintStart_toEndOf="@id/back_button"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Username Subtitle -->
        <TextView
            android:id="@+id/username_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_regular"
            android:text="\@alvarocrsc"
            android:textColor="#A5A5A5"
            android:textSize="11sp"
            android:letterSpacing="-0.03"
            android:layout_marginTop="-2dp"
            app:layout_constraintStart_toStartOf="@id/import_title"
            app:layout_constraintTop_toBottomOf="@id/import_title" />

        <!-- Upload Files Dashed Box -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/upload_files_container"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_dashed_border"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/username_subtitle">

            <ImageView
                android:id="@+id/upload_icon"
                android:layout_width="15dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share_light"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/upload_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed" />

            <TextView
                android:id="@+id/upload_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:fontFamily="@font/geist_bold"
                android:text="Upload files"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:letterSpacing="-0.025"
                app:layout_constraintStart_toEndOf="@id/upload_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Imported Files Header -->
        <TextView
            android:id="@+id/imported_files_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/geist_black"
            android:text="Imported files"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:letterSpacing="-0.016"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/upload_files_container" />

        <!-- Date Range -->
        <TextView
            android:id="@+id/date_range_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_medium"
            android:text="2021 · 2024"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:letterSpacing="-0.03"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/imported_files_header" />

        <!-- Divider Line -->
        <View
            android:id="@+id/divider_top"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="#333333"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imported_files_header" />

        <!-- RecyclerView for Imported Files -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/imported_files_recycler"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_top" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/empty_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/geist_regular"
            android:text="No files imported yet"
            android:textColor="#A5A5A5"
            android:textSize="11sp"
            android:letterSpacing="-0.03"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_top" />

</androidx.constraintlayout.widget.ConstraintLayout>

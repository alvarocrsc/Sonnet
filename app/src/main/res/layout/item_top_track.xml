<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/track_image_card"
        android:layout_width="92dp"
        android:layout_height="92dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        
        <ImageView
            android:id="@+id/track_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
            
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/track_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#A5A5A5"
        android:fontFamily="@font/geistmono_regular"
        android:textSize="9sp"
        app:layout_constraintTop_toTopOf="@id/track_name"
        app:layout_constraintBottom_toBottomOf="@id/track_name"
        app:layout_constraintVertical_bias="0.8"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/track_name"
        android:layout_width="79dp"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/geistmono_bold"
        android:textSize="11sp"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp"
        android:layout_marginStart="2dp"
        app:layout_constraintTop_toBottomOf="@id/track_image_card"
        app:layout_constraintStart_toEndOf="@id/track_rank"/>

    <TextView
        android:id="@+id/track_stats"
        android:layout_width="79dp"
        android:layout_height="wrap_content"
        android:textColor="#F2F2F2"
        android:fontFamily="@font/geistmono_light"
        android:letterSpacing="-0.02"
        android:textSize="8sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/track_name"
        app:layout_constraintStart_toStartOf="@id/track_name"/>

</androidx.constraintlayout.widget.ConstraintLayout>

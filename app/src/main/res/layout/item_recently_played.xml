<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="59dp"
    android:layout_marginTop="7dp"
    android:background="@drawable/bg_filter_unselected">

    <androidx.cardview.widget.CardView
        android:id="@+id/track_image"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:cardCornerRadius="5dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/track_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/track_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/geistmono_semibold"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:letterSpacing="-0.016"
        android:lineSpacingMultiplier="0.89"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/track_image"
        app:layout_constraintEnd_toStartOf="@id/rewind_icon"
        app:layout_constraintTop_toTopOf="@id/track_image"
        app:layout_constraintBottom_toBottomOf="@id/track_image"
        app:layout_constraintVertical_bias="0.36" />

    <TextView
        android:id="@+id/artist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/geistmono_light"
        android:layout_marginTop="-4dp"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:letterSpacing="-0.016"
        android:lineSpacingMultiplier="1.23"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/track_image"
        app:layout_constraintEnd_toStartOf="@id/rewind_icon"
        app:layout_constraintTop_toBottomOf="@id/track_name" />

    <ImageView
        android:id="@+id/rewind_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_last_listened_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/track_image"
        app:layout_constraintBottom_toBottomOf="@id/track_image"
        app:layout_constraintVertical_bias="0.35"/>

    <TextView
        android:id="@+id/time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/geistmono_light"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:letterSpacing="-0.016"
        android:lineSpacingMultiplier="1.23"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rewind_icon"
        app:layout_constraintVertical_bias="0.64" />

</androidx.constraintlayout.widget.ConstraintLayout>
